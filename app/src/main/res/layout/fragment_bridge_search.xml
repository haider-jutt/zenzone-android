<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_15sdp"
        android:orientation="vertical">

        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="@dimen/_120sdp">

            <View
                android:background="@drawable/rounded_circle_yellow"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_philips_hue" />
        </FrameLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_30sdp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/press_button_of_bridge_message"
            android:textColor="@color/white"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_20sdp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_2sdp"
            android:background="#64748B" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_20sdp" />

        <TextView
            android:id="@+id/viewProcessInformation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text=""
            android:textColor="@color/green"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_10sdp" />

        <com.zenimmersive.android.helper.SimpleLoadingMessageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>