<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/_110sdp"
    android:layout_height="@dimen/_130sdp"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardElevation="0dp"
    app:cardCornerRadius="@dimen/_10sdp">

    <ImageView
        android:id="@+id/ivMusic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:src="@drawable/ic_dummy_album" />

    <ImageView
        android:id="@+id/ivPlay"
        android:layout_width="@dimen/_35sdp"
        android:layout_height="@dimen/_35sdp"
        android:layout_gravity="center"
        android:scaleType="fitXY"
        android:src="@drawable/ic_player" />

    <FrameLayout
        android:id="@+id/viewPaidContainer"
        android:layout_gravity="center"
        android:background="@drawable/rounded_corner_green_gradiant"
        android:layout_margin="@dimen/_10sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/viewPaidText"
            android:textSize="@dimen/_12sdp"
            android:includeFontPadding="false"
            android:layout_margin="@dimen/_4sdp"
            android:layout_gravity="center"
            android:text="BUY 0.00 $"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>

    <TextView
        android:id="@+id/tvNew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_new"
        android:visibility="gone"
        android:textAllCaps="true"
        android:layout_margin="@dimen/_10sdp"
        app:fontFamily="@font/averia_libre"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_3sdp"
        android:background="@drawable/background_black_alpha_rounded"
        android:textSize="@dimen/_10ssp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/background_black_alpha"
        android:paddingVertical="@dimen/_5sdp"
        android:paddingHorizontal="@dimen/_5sdp"
        android:layout_gravity="bottom">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="On the Beach"
            android:textColor="@color/white"
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            app:fontFamily="@font/averia_libre" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_weight="1"
                android:id="@+id/llGuided"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/_11sdp"
                    android:layout_height="@dimen/_11sdp"
                    android:src="@drawable/ic_microphone"/>

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guided"
                    android:maxLines="1"
                    android:maxLength="6"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_8sdp"
                    android:textStyle="bold"
                    app:fontFamily="@font/averia_libre" />
            </LinearLayout>

            <LinearLayout
                android:layout_weight="1"
                android:id="@+id/llUnGuided"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/_11sdp"
                    android:layout_height="@dimen/_11sdp"
                    android:src="@drawable/ic_block_microphone"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unguided"
                    android:maxLines="1"
                    android:maxLength="7"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_8sdp"
                    android:textStyle="bold"
                    app:fontFamily="@font/averia_libre" />


            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:src="@drawable/ic_clock"/>

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="25:00 min"
                android:layout_marginStart="@dimen/_3sdp"
                android:textColor="@color/white"
                android:textSize="@dimen/_8sdp"
                android:textStyle="bold"
                app:fontFamily="@font/averia_libre" />


        </LinearLayout>


    </LinearLayout>

</androidx.cardview.widget.CardView>