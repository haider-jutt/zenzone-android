<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.player.PlayerFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.zenimmersive.android.helper.StatusBarSizeView
        android:id="@+id/statusBarSpace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/viewBackgroundImageParent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivMusicPackBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.4"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_dummy_album" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#16FFFFFF" />

        <View
            android:id="@+id/hueColorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.4" />

    </FrameLayout>


    <FrameLayout
        android:id="@+id/viewMusicPages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_90sdp"
        android:layout_marginEnd="@dimen/_30sdp"
        app:layout_constraintBottom_toTopOf="@+id/viewPlayerControls"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:id="@+id/viewPagerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/viewPagerIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/_15sdp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivPage1"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_weight="1"
                    android:padding="@dimen/_5sdp"
                    android:src="@drawable/ic_dot_default" />

                <ImageView
                    android:id="@+id/ivPage2"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_weight="1"
                    android:padding="@dimen/_5sdp"
                    android:src="@drawable/ic_dot_default" />

                <ImageView
                    android:id="@+id/ivPage3"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_weight="1"
                    android:padding="@dimen/_5sdp"
                    android:src="@drawable/ic_dot_default" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>



    <LinearLayout
        android:id="@+id/viewPlayerControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_15sdp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_15sdp">

            <TextView
                android:id="@+id/tvMusicPackName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_50sdp"
                android:textSize="@dimen/_14sdp"
                android:textStyle="bold"
                tools:text="SIRENA" />

            <TextView
                android:id="@+id/tvMusicPackDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvMusicPackName"
                android:layout_marginEnd="@dimen/_50sdp"
                android:textAllCaps="true"
                tools:text="Relex &#8226; Aqua, ELAVASIN" />

            <ImageView
                android:id="@+id/ivFavorite"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_15sdp"
                android:src="@drawable/ic_heart" />
        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <SeekBar
                android:id="@+id/view_seekbar_player_duration"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_15sdp"
                android:backgroundTint="#8E8E8E"
                android:clickable="true"
                android:progress="10"
                android:progressTint="#FF24CEF0"
                android:thumbTint="#FF24CEF0" />

            <TextView
                android:id="@+id/viewPlayerTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_9sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="00:00" />

            <TextView
                android:id="@+id/viewPlayerDurationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_9sdp"
                android:text="00:00" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:minHeight="@dimen/_50sdp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/viewToggleVolumePanel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/viewVolumControl"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_volume" />
            </FrameLayout>

            <Space
                android:layout_width="@dimen/_30sdp"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <FrameLayout
                    android:id="@+id/viewPrevious"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play_cont_prev" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/ivPlayerState"
                        android:layout_width="@dimen/_50sdp"
                        android:layout_height="@dimen/_50sdp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play_cont_play_huge" />

                    <ProgressBar
                        android:id="@+id/bufferLoaderView"
                        android:layout_width="@dimen/_50sdp"
                        android:layout_height="@dimen/_50sdp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#151521" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/viewNext"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play_cont_next" />
                </FrameLayout>
            </LinearLayout>

            <Space
                android:layout_width="@dimen/_30sdp"
                android:layout_height="wrap_content" />

            <FrameLayout
                android:id="@+id/viewCastButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_airplay" />
                <!--            <androidx.mediarouter.app.MediaRouteButton-->
                <!--                android:backgroundTint="@color/white"-->
                <!--                android:layout_gravity="center"-->
                <!--                android:layout_width="@dimen/_25sdp"-->
                <!--                android:layout_height="@dimen/_25sdp"/>-->
            </FrameLayout>
        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_10sdp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/viewVolumeHueParent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_30sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/volumePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_30sdp"
            android:layout_marginTop="@dimen/_60sdp"
            android:layout_marginEnd="@dimen/_30sdp"
            android:layout_marginBottom="@dimen/_60sdp"
            android:background="#80161B1D"
            android:clickable="true"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:id="@+id/viewCloseVolumePanel"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_gravity="end"
                android:layout_margin="@dimen/_15sdp"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:text="@string/tab_music"
                android:textColor="@color/white"
                android:textSize="@dimen/_14sdp"
                android:textStyle="bold"
                app:fontFamily="@font/averia_libre" />


            <LinearLayout
                android:id="@+id/viewVolumControl1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_15sdp"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:padding="@dimen/_5sdp"
                    android:src="@drawable/ic_volume_panel" />

                <SeekBar
                    android:id="@+id/viewSeekbarMusicPlayerVolume"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:progressTint="@color/white"
                    android:thumbTint="@color/white" />


            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:id="@+id/viewNarratorSwitchPanel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:minHeight="@dimen/_50sdp"
                    android:visibility="gone"
                    tools:visibility="visible">


                    <TextView
                        android:id="@+id/textNarrativeAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="@string/tab_narrator"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_14sdp"
                        android:textStyle="bold"
                        app:fontFamily="@font/averia_libre" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/viewSwitchNarrative"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:layout_toRightOf="@id/textNarrativeAudio"
                        android:checked="true" />
                </RelativeLayout>

                <ImageView
                    android:id="@+id/ivCaptionState"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:src="@drawable/ic_caption_default"
                    android:visibility="gone" />
            </FrameLayout>


            <LinearLayout
                android:id="@+id/viewVolumControl2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_15sdp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_gravity="center"
                    android:padding="@dimen/_5sdp"
                    android:src="@drawable/ic_narrator" />

                <SeekBar
                    android:id="@+id/viewSeekbarVoiceMusicPlayerVolume"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:progressTint="@color/white"
                    android:thumbTint="@color/white" />


            </LinearLayout>

            <Space
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/hueControlPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_30sdp"
            android:layout_marginTop="@dimen/_60sdp"
            android:layout_marginEnd="@dimen/_30sdp"
            android:layout_marginBottom="@dimen/_60sdp"
            android:background="#80161B1D"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_15sdp"
                android:clickable="true"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/brightnessSeekbarParent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:clickable="true"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/_60sdp"
                        android:layout_height="@dimen/_60sdp"
                        android:layout_gravity="center"
                        android:padding="@dimen/_5sdp"
                        android:src="@drawable/ic_brightness" />

                    <SeekBar
                        android:id="@+id/sliderBrightness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:clickable="true"
                        android:max="100"
                        android:progress="20"
                        android:progressTint="@color/white"
                        android:thumbTint="@color/white" />

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/hue_static_color_parent"
                    android:layout_width="@dimen/_155sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:background="@drawable/button_shape_default">

                    <ImageView
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:padding="@dimen/_5sdp"
                        android:src="@drawable/ic_static_color" />

                    <TextView
                        android:id="@+id/viewStaticColorText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/_35sdp"
                        android:layout_marginEnd="@dimen/_25sdp"
                        android:text="@string/pick_static_color_text"
                        android:textSize="@dimen/_12sdp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/hueConfigurePanel"
                    android:layout_width="@dimen/_155sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:background="@drawable/button_shape_default">

                    <ImageView
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:padding="@dimen/_5sdp"
                        android:src="@drawable/ic_setting" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/_35sdp"
                        android:layout_marginEnd="@dimen/_25sdp"
                        android:text="@string/lights_configuration"
                        android:textSize="@dimen/_12sdp"
                        android:textStyle="bold" />
                </FrameLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/viewCloseHuePanel"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_gravity="end"
                android:layout_margin="@dimen/_15sdp"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/viewColorWheelPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_30sdp"
            android:layout_marginTop="@dimen/_60sdp"
            android:layout_marginEnd="@dimen/_30sdp"
            android:layout_marginBottom="@dimen/_60sdp"
            android:background="#80161B1D"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/_10sdp">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_25sdp" />

                <com.zenimmersive.android.helper.SquareLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.skydoves.colorpickerview.ColorPickerView
                        android:id="@+id/colorPickerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.zenimmersive.android.helper.SquareLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/viewColorWheel"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:background="@drawable/colo_wheel">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/rounded_circle_white" />
                    </FrameLayout>

                    <Space
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:id="@+id/viewColorWhiteAmbienceWheel"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:background="@drawable/white_ambience">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/viewCloseColorWheelPanel"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_gravity="end"
                android:layout_margin="@dimen/_15sdp"
                android:src="@drawable/ic_close" />
        </FrameLayout>


    </FrameLayout>

    <FrameLayout
        android:id="@+id/viewToggleBrightnessPanel"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_50sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarSpace">

        <ImageView
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_gravity="center"
            android:padding="@dimen/_5sdp"
            android:src="@drawable/ic_brightness" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/llNotFoundData"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/windowBackground"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="@dimen/_40sdp"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/_130sdp"
            android:layout_height="@dimen/_130sdp"
            android:src="@drawable/ic_not_found" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="@string/we_re_sorry"
            android:textColor="@color/white"
            android:textSize="@dimen/_20ssp"
            app:fontFamily="@font/abel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/could_not_found_song"
            android:textColor="@color/white"
            android:textSize="@dimen/_12ssp"
            app:fontFamily="@font/abel" />
    </LinearLayout>


    <include
        android:id="@+id/invLoader"
        layout="@layout/view_loader" />


</androidx.constraintlayout.widget.ConstraintLayout>