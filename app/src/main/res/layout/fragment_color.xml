<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="@dimen/_15sdp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ColorFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.zenimmersive.android.helper.SquareLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.skydoves.colorpickerview.ColorPickerView
                android:id="@+id/colorPickerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.zenimmersive.android.helper.SquareLayout>

        <com.zenimmersive.android.helper.SimpleLoadingMessageView
            android:id="@+id/bridgeSyncMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            tools:visibility="visible"
            android:visibility="gone" />

        <LinearLayout
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/viewColorWheel"
                android:background="@drawable/colo_wheel"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp">

                <View
                    android:layout_width="match_parent"
                    android:background="@drawable/rounded_circle_white"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <Space
                android:layout_width="@dimen/_5sdp"
                android:layout_height="wrap_content" />

            <FrameLayout
                android:id="@+id/viewColorWhiteAmbienceWheel"
                android:layout_width="@dimen/_30sdp"
                android:background="@drawable/white_ambience"
                android:layout_height="@dimen/_30sdp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>