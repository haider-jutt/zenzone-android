<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageContainer"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/viewDashboardFragmentContainer"
        android:layout_width="match_parent"
        android:layout_marginBottom="@dimen/_45sdp"
        android:layout_height="match_parent">

    </FrameLayout>


    <FrameLayout
        android:id="@+id/viewBottomControls"
        android:layout_width="match_parent"
        android:elevation="@dimen/_5sdp"
        android:layout_height="@dimen/_45sdp"
        android:background="#24242E"
        app:layout_constraintBottom_toBottomOf="parent">


        <LinearLayout
            android:layout_marginBottom="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <FrameLayout
                android:id="@+id/navHome"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_gravity="center"
                    android:padding="@dimen/_1sdp"
                    android:src="@drawable/home_4" />
            </FrameLayout>


            <FrameLayout
                android:id="@+id/navHeart"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_heart" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navPlayer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_player" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navDownload"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/download_1" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navUser"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:padding="@dimen/_1sdp"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_user" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:id="@+id/viewIndicationLine"
            android:translationX="@dimen/_140sdp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/_8sdp"
            android:background="@drawable/bottom_line"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_2sdp" />
    </FrameLayout>

    <RelativeLayout
        android:id="@+id/viewToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <com.zenimmersive.android.helper.StatusBarSizeView
            android:id="@+id/statusBarSpace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <FrameLayout
            android:layout_below="@id/statusBarSpace"
            android:minHeight="@dimen/_50sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivBack"
                android:visibility="gone"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:layout_gravity="center_vertical"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/tvPageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/_35sdp"
                android:layout_marginEnd="@dimen/_35sdp"
                android:gravity="center"
                android:text="@string/page_title"
                android:textSize="@dimen/_14sdp"
                android:textStyle="bold"
                app:fontFamily="@font/inter" />
        </FrameLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>